# StoryBlender local configuration template.
#
# To make Blender/Gradio auto-fill your settings:
# 1. Copy this file to `.env` in the repository/add-on root.
# 2. Fill in the values you use.
# 3. Launch StoryBlender normally from Blender.
#
# `.env` is ignored by git, so keep real API keys there, not in source files.
# You can also point StoryBlender at another file with:
# STORYBLENDER_ENV_FILE=/absolute/path/to/your/storyblender.env

# Required: AnyLLM settings used by reasoning and vision steps.
# Fill all three values.
ANYLLM_API_KEY=
ANYLLM_API_BASE=
ANYLLM_PROVIDER=gemini

# Required for image generation if STORYBLENDER_IMAGE_GEN_PLATFORM=Gemini.
# Fill this group OR the OpenAI-compatible group below.
GEMINI_API_KEY=
GEMINI_API_BASE=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# Required for image generation if STORYBLENDER_IMAGE_GEN_PLATFORM=OpenAI.
# Fill this group OR the Gemini group above.
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_IMAGE_MODEL=grok-imagine-image

# Optional: required only if you want to retrieve 3D models from Sketchfab.
SKETCHFAB_API_KEY=

# Required for 3D model generation if STORYBLENDER_AI_PLATFORM=Meshy.
# Fill this group OR the Tencent Hunyuan3D group below.
MESHY_API_KEY=
MESHY_MODEL=latest

# Required for 3D model generation if STORYBLENDER_AI_PLATFORM=Hunyuan3D.
# Fill this group OR the Meshy group above.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# Optional: Uthana animation settings.
# Leave empty to skip the Uthana pipeline and animation auto pipeline.
UTHANA_API_KEY=
UTHANA_FPS=24

# Defaults shown in the Gradio Configuration panel.
STORYBLENDER_REASONING_MODEL=gemini-3.1-pro-preview
STORYBLENDER_VISION_MODEL=gemini-3-flash-preview

# Choose which image generation group to use: Gemini or OpenAI.
STORYBLENDER_IMAGE_GEN_PLATFORM=OpenAI

# Choose which 3D generation group to use: Hunyuan3D or Meshy.
STORYBLENDER_AI_PLATFORM=Hunyuan3D

# Optional absolute project directory. Leave empty to enter it in the UI.
STORYBLENDER_PROJECT_DIR=
